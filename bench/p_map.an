#: 主程序 b
add val "参" list(str) = args()
add val "n" int = 200000
if len(call val "参") > 1:
    val "n" = int(call val "参"[2])
;
add val "配" map(int, int) = {}
add val "i" int = 0
while call val "i" < call val "n" max 2000001:
    put(call val "配", call val "i", call val "i" * 2)
    val "i" = call val "i" + 1
;
add val "和" int = 0
add val "j" int = 0
while call val "j" < call val "n" max 2000001:
    val "和" = call val "和" + call val "配"[call val "j"]
    val "j" = call val "j" + 1
;
print(call val "和")
#: 主程序 d
