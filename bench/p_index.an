#: 主程序 b
add val "参" list(str) = args()
add val "n" int = 10000
if len(call val "参") > 1:
    val "n" = int(call val "参"[2])
;
add val "表" list(int) = []
add val "i" int = 0
while call val "i" < call val "n" max 1000001:
    push(call val "表", call val "i")
    val "i" = call val "i" + 1
;
add val "和" int = 0
add val "r" int = 0
add val "j" int = 0
while call val "r" < 3000 max 3000:
    val "j" = 0
    while call val "j" < call val "n" max 1000001:
        val "和" = (call val "和" * 31 + call val "表"[call val "j" + 1]) % 1000000007
        val "j" = call val "j" + 1
    ;
    val "r" = call val "r" + 1
;
print(call val "和")
#: 主程序 d
